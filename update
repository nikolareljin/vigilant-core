#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_HELPERS_PATH="scripts/script-helpers"
SCRIPT_HELPERS_DIR="$ROOT_DIR/$SCRIPT_HELPERS_PATH"
cd "$ROOT_DIR"

echo "Synchronizing submodule URLs..."
git submodule sync --recursive

echo "Updating submodules (fetching latest remote commits)..."
if ! git submodule update --init --remote --recursive; then
  echo "Remote submodule update failed. Falling back to pinned revisions..."
  git submodule update --init --recursive
fi

if [[ -d "$SCRIPT_HELPERS_DIR/.git" || -f "$SCRIPT_HELPERS_DIR/.git" ]]; then
  echo "Aligning $SCRIPT_HELPERS_PATH to the production branch..."
  if git -C "$SCRIPT_HELPERS_DIR" show-ref --verify --quiet refs/remotes/origin/production; then
    git -C "$SCRIPT_HELPERS_DIR" checkout -B production origin/production
  else
    echo "origin/production not available locally for $SCRIPT_HELPERS_PATH; keeping current checkout." >&2
  fi
fi

if [[ ! -f "$SCRIPT_HELPERS_DIR/helpers.sh" ]]; then
  SHARED_HELPERS_DIR="$ROOT_DIR/../script-helpers"
  if [[ -f "$SHARED_HELPERS_DIR/helpers.sh" ]]; then
    echo "script-helpers submodule missing; using shared workspace copy..."
    mkdir -p "$SCRIPT_HELPERS_DIR"
    cp -R "$SHARED_HELPERS_DIR/." "$SCRIPT_HELPERS_DIR/"
  fi
fi

if [[ ! -f "$SCRIPT_HELPERS_DIR/helpers.sh" ]]; then
  echo "script-helpers still not found. Ensure submodules are available or run from a clone with access." >&2
  exit 1
fi

echo "Submodules are up to date."
